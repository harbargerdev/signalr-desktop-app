<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SignalR.Event.Handler.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SignalR.Event.Handler.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SignalR Event Handler">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- User Details Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="User Details" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="UserName:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" 
                         x:Name="UserNameTextBox"
                         Text="{x:Bind UserName, Mode=OneWay}" 
                         IsReadOnly="True" 
                         Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>
            </Grid>
        </StackPanel>

        <!-- Event Details Section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Event Details" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="15"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- User ID -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="User ID:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" 
                             Text="{x:Bind LatestEvent.UserId, Mode=OneWay}" 
                             IsReadOnly="True" 
                             Margin="0,0,0,10"
                             Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>

                    <!-- Event ID -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="Event ID:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" 
                             Text="{x:Bind LatestEvent.EventId, Mode=OneWay}" 
                             IsReadOnly="True" 
                             Margin="0,0,0,10"
                             Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>

                    <!-- Event Name -->
                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="Event Name:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" 
                             Text="{x:Bind LatestEvent.EventName, Mode=OneWay}" 
                             IsReadOnly="True" 
                             Margin="0,0,0,10"
                             Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>

                    <!-- Event Description -->
                    <TextBlock Grid.Row="3" Grid.Column="0" 
                               Text="Event Description:" 
                               VerticalAlignment="Top" 
                               Margin="0,5,10,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" 
                             Text="{x:Bind LatestEvent.EventDescription, Mode=OneWay}" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="60"
                             Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Action Row -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
            <Button x:Name="ExitButton" 
                    Content="Exit" 
                    Click="ExitButton_Click"
                    MinWidth="120"/>
            <Button x:Name="ForcePullButton" 
                    Content="Force Pull" 
                    Click="ForcePullButton_Click"
                    MinWidth="120"
                    Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="ReconnectButton" 
                    Content="Reconnect" 
                    Click="ReconnectButton_Click"
                    MinWidth="120"/>
        </StackPanel>

        <!-- Status Bar -->
        <Border Grid.Row="4" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Connection Status:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ConnectionStatusLabel" 
                           Text="{x:Bind ConnectionStatus, Mode=OneWay}" 
                           VerticalAlignment="Center"
                           Foreground="{x:Bind ConnectionStatusBrush, Mode=OneWay}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
